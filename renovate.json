{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
	"abandonmentThreshold": "2 years",
	"minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Limit Active-Reports to minor and patch updates only",
      "matchPackageNames": [
        "@grapecity/activereports",
        "activereportsjs",
        "grapecity/activereports"
      ],
      "major": {
        "enabled": false
      },
      "groupName": "active-reports-minor-patch"
    },
    {
      "description": "Limit AG-Grid to minor and patch updates only",
      "matchPackageNames": [
        "@ag-grid-community/all-modules",
        "@ag-grid-enterprise/all-modules",
        "ag-grid-community",
        "ag-grid-enterprise"
      ],
      "major": {
        "enabled": false
      },
      "groupName": "ag-grid-minor-patch"
    },
    {
			"description": "Ignore internal @humalytix packages",
			"enabled": false,
			"matchPackageNames": ["/^@humalytix//"]
		},
		{
			"description": "Ignore Harness private Terraform modules",
			"matchManagers": ["terraform"],
			"matchPackageNames": ["/^app\\.harness\\.io/"],
			"enabled": false
		}
  ],
"prConcurrentLimit": 5,
	"rebaseWhen": "behind-base-branch",
	"vulnerabilityAlerts": {
		"labels": ["security"],
		"automerge": true
	}
}
